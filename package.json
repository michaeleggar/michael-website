{
  "name": "michael-website",
  "scripts": {
    "images": "node scripts/optimize-image.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && eleventy",
    "dev": "eleventy --serve",
    "verify": "npm run build && node scripts/check-build.js",
    "bundle": "node scripts/bundle-scripts.js",
    "prebuild": "npm run bundle",
    "predev": "npm run bundle"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "dialkit": "2.0.2",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "motion-dom": "^14.1.0"
  }
}
