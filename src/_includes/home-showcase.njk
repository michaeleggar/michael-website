{% from "showcase-cards.njk" import workCard, artCard %}
<section class="page-section home-showcase" aria-label="Work and art">
  <div class="showcase-stage" id="art-gallery" data-showcase aria-label="Explore work and art">
    {% set selectedArt = art | featuredArtwork(site.featuredArt) %}
    {% set fanCenter = (collections.workProjects.length + selectedArt.length - 1) / 2 %}
    {% for project in collections.workProjects %}
      {% set workPosition = loop.index0 * 2 %}
      {% if loop.index0 >= selectedArt.length %}{% set workPosition = loop.index0 + selectedArt.length %}{% endif %}
      {{ workCard(project, workPosition, fanCenter) }}
      {% if loop.index0 < selectedArt.length %}{{ artCard(selectedArt[loop.index0], loop.index0 * 2 + 1, fanCenter) }}{% endif %}
    {% endfor %}
  </div>
  <div class="showcase-label" data-showcase-caption aria-hidden="true"><span class="showcase-title"></span> <span class="showcase-tag showcase-category"></span> <span class="showcase-tag showcase-year"></span></div>
  <span class="visually-hidden" data-showcase-status role="status" aria-live="polite"></span>
  <dialog id="art-modal" aria-labelledby="modal-title">
    <button type="button" class="modal-close" aria-label="Close artwork">{% include "icons/close-micro.svg" %}</button>
    <div class="modal-content">
      <img id="modal-img" alt="" />
      <div class="modal-info"><h2 id="modal-title"></h2><p id="modal-details"></p></div>
    </div>
  </dialog>
</section>
