<dialog id="art-modal" aria-labelledby="modal-title">
  <div class="modal-browser">
    <button type="button" class="modal-neighbor modal-previous" aria-label="Previous artwork">
      <img alt="" data-neighbor-image />
      <span class="modal-arrow" aria-hidden="true">{% include "icons/arrow-left-micro.svg" %}</span>
    </button>
    <div class="modal-current">
      <button type="button" class="modal-close site-nav-link" aria-label="Close artwork">Close</button>
      <div class="modal-content">
        <img id="modal-img" alt="" />
        <div class="modal-info"><h2 id="modal-title"></h2><p id="modal-details"></p></div>
      </div>
      <div class="modal-pagination" aria-label="Browse artworks"></div>
      <span class="visually-hidden" role="status" data-art-viewer-status></span>
    </div>
    <button type="button" class="modal-neighbor modal-next" aria-label="Next artwork">
      <img alt="" data-neighbor-image />
      <span class="modal-arrow" aria-hidden="true">{% include "icons/arrow-right-micro.svg" %}</span>
    </button>
  </div>
</dialog>
