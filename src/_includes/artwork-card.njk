<figure class="art-item" style="--art-placeholder: url({{ artPlaceholders[artwork | artworkSlug] }});">
  <button
    type="button"
    id="{{ artwork | artworkSlug }}"
    aria-label="View {{ artwork.title | escape }}"
    data-modal-src="{{ artwork.image }}-large.webp"
    data-alt="{{ artwork.alt | escape }}"
    data-title="{{ artwork.title | escape }}"
    data-year="{{ artwork.year | escape }}"
    data-medium="{{ artwork.medium | escape }}"
    data-dimensions="{{ artwork.dimensions_text | escape }}"
  >
    <img
      src="{{ artwork.image }}-thumb.webp"
      srcset="{{ artwork.image }}-small.webp 320w, {{ artwork.image }}-thumb.webp 600w"
      sizes="(max-width: 780px) calc((100vw - 48px) / 2), min(calc((100vw - 128px) / 4), 248px)"
      width="{{ artwork.width }}"
      height="{{ artwork.height }}"
      loading="lazy"
      decoding="async"
      onload="this.setAttribute('data-loaded', '')"
      onerror="this.setAttribute('data-loaded', '')"
      alt="{{ artwork.alt | escape }}"
    />
  </button>
</figure>
