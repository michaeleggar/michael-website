{#- The project's hero mockup, set in the copy when the showcase leads the page.
    Expects `heroImage` in page data. -#}
<figure class="portfolio-wide-media portfolio-snug-media">
  <img
    src="{{ heroImage.image }}-large.webp"
    srcset="{{ heroImage.image }}-thumb.webp 600w, {{ heroImage.image }}-large.webp {{ heroImage.width }}w"
    sizes="(min-width: 720px) 680px, 100vw"
    width="{{ heroImage.width }}"
    height="{{ heroImage.height }}"
    alt="{{ heroImage.alt }}"
    loading="lazy"
    decoding="async"
  />
</figure>
