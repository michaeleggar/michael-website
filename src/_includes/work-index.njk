{#- The Work list, shared by the Work page and every case study. On the Work page
    it spans the page with each project's year, agency, and roles; once a project
    is open it narrows to the titles beside it. -#}
<nav class="work-index" aria-label="Projects">
  <ul class="work-index-list">
    {% for project in collections.workProjects %}
      {% set roles = [] %}
      {% for group in project.data.projectDetails %}
        {% if group.label == "My role" %}{% set roles = group.items %}{% endif %}
      {% endfor %}
      <li>
        <a
          class="work-index-link"
          href="{{ project.url }}"
          data-work-project="{{ project.fileSlug }}"
          {% if project.url == page.url %}aria-current="page"{% endif %}
        >
          <span class="work-index-title">{{ project.data.cardTitle }}</span>
          <span class="work-index-meta">
            <time class="work-index-year" datetime="{{ project.data.year }}">{{ project.data.year }}</time>
            <span class="work-index-agency">{{ project.data.agency }}</span>
            <span class="work-index-roles">{% for role in roles %}{{ role.label or role }}{% if not loop.last %}, {% endif %}{% endfor %}</span>
          </span>
        </a>
      </li>
    {% endfor %}
  </ul>
</nav>
