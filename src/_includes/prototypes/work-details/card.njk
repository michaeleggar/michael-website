{% include "prototypes/work-details/intro.njk" %}
<div class="preview-details-block">
  <dl class="credits-card" aria-label="Project details">
    <div class="credits-card-agency"><dt>Agency</dt><dd>{{ preview.agency }}</dd></div>
    <div class="credits-card-year"><dt>Year</dt><dd>{{ preview.year }}</dd></div>
    <div class="credits-card-role"><dt>Role</dt><dd>{{ preview.roles | join(" / ") }}</dd></div>
    <div class="credits-card-contributors"><dt>Contributors</dt><dd><ul class="credit-list">{% for person in preview.contributors %}<li><span class="credit-person">{{ person.name }}</span><span class="credit-line">{{ person.role }}</span></li>{% endfor %}</ul></dd></div>
  </dl>
  {% include "prototypes/work-details/live-link.njk" %}
</div>
