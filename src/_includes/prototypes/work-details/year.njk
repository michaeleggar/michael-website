{% include "prototypes/work-details/intro.njk" %}
<div class="preview-details-block preview-details-wide">
  <dl class="credits-year-stamp" aria-label="Project details">
    <div class="credits-year"><dt>Year</dt><dd>{{ preview.year }}</dd></div>
    <div class="credits-year-agency"><dt>Agency</dt><dd>{{ preview.agency }}</dd></div>
    <div class="credits-year-role"><dt>Role</dt><dd>{{ preview.roles | join(" / ") }}</dd></div>
    <div class="credits-year-contributors"><dt>Contributors</dt><dd><ul class="credit-list">{% for person in preview.contributors %}<li>{{ person.name }} <span>— {{ person.role }}</span></li>{% endfor %}</ul></dd></div>
  </dl>
  {% include "prototypes/work-details/live-link.njk" %}
</div>
