{#- The hero: a recording of the site, then the project's name and its
    details (agency and year, role, tools, contributors, the live site) stacked
    under it in the copy column. `heroClip` names one of the page's
    `recordings` to lead, playing; with none, the hero is the name and details.
    `heroTitle` sets the title as lines; it falls back to `heading` or `cardTitle`. -#}
{% set screen = recordings[heroClip] if heroClip and recordings else null %}
<header class="case-hero" data-case-hero{% if screen %} data-screen{% endif %}>
  {% if screen %}
  {#- Plays like the other clips (case-study.js). -#}
  <figure class="case-hero-screen" data-clip style="--ratio: {{ (screen.width / screen.height) | round(4) }};">
    <video muted loop playsinline preload="auto" poster="{{ screen.poster }}" width="{{ screen.width }}" height="{{ screen.height }}" aria-label="{{ screen.label }}">
      <source src="{{ screen.video }}" type="video/mp4" />
    </video>
  </figure>
  {% endif %}

  <div class="case-hero-masthead">
    <h1>
      {% if heroTitle %}
        {% for line in heroTitle %}<span class="case-title-line">{{ line }}</span>{% endfor %}
      {% else %}
        {{ heading or cardTitle }}
      {% endif %}
    </h1>
    <dl class="project-details" aria-label="Project details">
      {% if agency %}
      <div><dt>Agency</dt><dd>{{ agency }}, <span class="project-details-year">{{ year }}</span></dd></div>
      {% else %}
      <div><dt>Year</dt><dd class="project-details-year-standalone">{{ year }}</dd></div>
      {% endif %}
      {% for group in projectDetails %}
        <div>
          <dt>{{ group.label }}</dt>
          <dd>
            {% for item in group.items %}
              {% if item.href %}<a href="{{ item.href }}" target="_blank" rel="noopener noreferrer"{% if group.label == "Link" %} class="project-details-live"{% endif %}>{{ item.label }}{% if group.label == "Link" %}{% include "icons/arrow-up-right-solid-micro.svg" %}{% endif %}</a>{% else %}{{ item.label or item }}{% endif %}{% if not loop.last %}{% if group.label == "My role" %} / {% else %}, {% endif %}{% endif %}
            {% endfor %}
          </dd>
        </div>
      {% endfor %}
      {% if contributors and contributors.length %}
      <div>
        <dt>Contributors</dt>
        <dd>
          <ul class="project-credit-list">
            {% for person in contributors %}
              <li><span class="project-credit-person">{{ person.name }}</span>, <span class="project-credit-role">{{ person.role }}</span></li>
            {% endfor %}
          </ul>
        </dd>
      </div>
      {% endif %}
    </dl>
  </div>
</header>
