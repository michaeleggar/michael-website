{#- The previous and next case studies, wrapping around the Work list, so a
    reader at the end of one project can step to the next without going back. -#}
{% set neighbors = collections.workProjects | workNeighbors(page.url) %}
{% if neighbors %}
<nav class="project-footer" aria-label="More work">
  {% for step in [["previous", neighbors.previous, "Previous"], ["next", neighbors.next, "Next"]] %}
    {% set project = step[1] %}
    <a class="project-footer-link" href="{{ project.url }}" data-direction="{{ step[0] }}">
      <span class="project-footer-image image-preview" style="--image-preview: url({{ placeholders[project.data.cardImage.image] }});">
        <img src="{{ project.data.cardImage.image }}-thumb.webp" width="{{ project.data.cardImage.width }}" height="{{ project.data.cardImage.height }}" alt="" loading="lazy" decoding="async" />
      </span>
      <span class="project-footer-text">
        <span class="project-footer-label">
          {% if step[0] == "previous" %}{% include "icons/arrow-left-micro.svg" %}{% endif %}
          {{ step[2] }}
          {% if step[0] == "next" %}{% include "icons/arrow-right-micro.svg" %}{% endif %}
        </span>
        <span class="project-footer-title">{{ project.data.cardTitle }}</span>
      </span>
    </a>
  {% endfor %}
</nav>
{% endif %}
