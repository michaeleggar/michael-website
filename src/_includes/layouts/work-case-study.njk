---
layout: layouts/base.njk
stylesheets: [case-study]
scripts: [case-study]
---

<main id="main-content" class="page-content portfolio-case-study">
  {% set liveSiteUrl = "" %}
  {% for group in projectDetails %}
    {% if group.label == "Link" %}
      {% for item in group.items %}
        {% if item.href and not liveSiteUrl %}{% set liveSiteUrl = item.href %}{% endif %}
      {% endfor %}
    {% endif %}
  {% endfor %}
  {% include "case-hero.njk" %}

  <div class="case-lede"><p>{{ deck }}</p></div>

  {{ content | safe }}

  {% if footnotes and footnotes.length %}
  <section class="case-footnotes" aria-labelledby="footnotes-title">
    <h2 id="footnotes-title">Notes</h2>
    <ol>
      {% for note in footnotes %}
        <li id="note-{{ loop.index }}"><span>{{ note | safe }}</span></li>
      {% endfor %}
    </ol>
  </section>
  {% endif %}

  {% include "work-project-nav.njk" %}
</main>
