---
layout: layouts/base.njk
stylesheets: [case-study]
---

<main id="main-content" class="page-content portfolio-case-study">
  {% include "work-back-link.html" %}

  <header class="portfolio-project-intro">
    <h1>{{ heading or cardTitle }}</h1>
    <p class="portfolio-project-deck">{{ deck }}</p>
  </header>

  <dl class="project-details" aria-label="Project details">
    {% for group in projectDetails %}
      <div>
        <dt>{{ group.label }}</dt>
        <dd>
          {% for item in group.items %}
            {% if item.href %}<a href="{{ item.href }}" target="_blank" rel="noopener noreferrer">{{ item.label }}</a>{% else %}{{ item.label or item }}{% endif %}{% if not loop.last %}, {% endif %}
          {% endfor %}
        </dd>
      </div>
    {% endfor %}
  </dl>

  {% if heroImage %}
    <figure class="portfolio-wide-media portfolio-first-media">
      <img
        src="{{ heroImage.image }}-large.webp"
        srcset="{{ heroImage.image }}-thumb.webp 600w, {{ heroImage.image }}-large.webp {{ heroImage.width }}w"
        sizes="100vw"
        width="{{ heroImage.width }}"
        height="{{ heroImage.height }}"
        alt="{{ heroImage.alt }}"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  {% endif %}

  {{ content | safe }}
</main>
