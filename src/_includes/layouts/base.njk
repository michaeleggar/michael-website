<!doctype html>
<html lang="en">
  <head>
    {% include "head.html" %}
    <link rel="stylesheet" href="/assets/css/styles.css" />
    <link rel="stylesheet" href="/assets/css/header.css" />
    <link rel="stylesheet" href="/assets/css/music-player.css" />
    {% for stylesheet in stylesheets %}
      <link rel="stylesheet" href="/assets/css/{{ stylesheet }}.css" data-page-style />
    {% endfor %}
  </head>
  <body>
    <a class="skip-nav" href="#main-content">Skip to main content</a>
    {% include "edge-blur.njk" %}
    {% include "site-header.html" %}
    {% include "music-player.html" %}
    {{ content | safe }}
    <script src="/assets/scripts/copy-email.js" defer></script>
    <script src="/assets/scripts/music-player.js" defer></script>
    <script src="/assets/scripts/page-navigation.js" defer></script>
    {% for script in scripts %}
      <script src="/assets/scripts/{{ script }}.js" data-page-script></script>
    {% endfor %}
    {% if navigationTuningEnabled %}
      <script type="module" src="/assets/scripts/site-color-tuner.js"></script>
      <script type="module" src="/assets/scripts/navigation-tuner.js"></script>
    {% endif %}
  </body>
</html>
