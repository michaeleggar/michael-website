{#- Homepage captures of a live site in a browser window and a phone, built like
    the CD player: frosted molded shells, a sage LCD, and aluminum keys. They sit
    on the page itself; case-study.js lets visitors drag them anywhere by the top
    bar, resize them from the corner, and fills each level as its screen scrolls.
    Expects `siteShowcase` in page data. -#}
{% set show = siteShowcase %}
{% set hint = "showcase-hint-" + page.fileSlug %}
<section class="site-showcase{% if leadShowcase %} site-showcase-lead{% endif %}" aria-label="{{ show.url }} homepage" data-site-showcase>
  <div class="site-showcase-layout">
    <div class="site-showcase-window" data-showcase-window>
      <div class="site-showcase-bar">
        <span class="site-showcase-handle" tabindex="0" role="button" aria-label="Move the desktop window" aria-describedby="{{ hint }}" data-drag-handle></span>
        <span class="site-showcase-dots" aria-hidden="true"></span>
        <span class="site-showcase-lcd">
          <span class="site-showcase-lcd-url">{{ show.url }}</span>
          <span class="site-showcase-level" aria-hidden="true"></span>
        </span>
        <button type="button" class="site-showcase-key" aria-label="Put the window back" title="Put it back" data-showcase-reset>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8a4.5 4.5 0 1 0 1.32-3.18" /><path d="M3.25 2.5v2.75H6" /></svg>
        </button>
        <a class="site-showcase-key site-showcase-key-go" href="{{ show.href }}" target="_blank" rel="noopener noreferrer" aria-label="Open {{ show.url }} in a new tab" title="Open {{ show.url }}">
          {% include "icons/arrow-up-right-solid-micro.svg" %}
        </a>
      </div>
      <div class="site-showcase-screen">
        <div class="site-showcase-viewport" tabindex="0" role="region" aria-label="{{ show.url }} on desktop, scrollable">
          <img src="{{ show.desktop.image }}" width="{{ show.desktop.width }}" height="{{ show.desktop.height }}" alt="{{ show.alt }} on desktop" loading="lazy" decoding="async" />
        </div>
      </div>
      <span class="site-showcase-grip" tabindex="0" role="button" aria-label="Resize the desktop window" aria-describedby="{{ hint }}" data-resize-handle></span>
    </div>

    <div class="site-showcase-phone" data-showcase-window data-keep-aspect>
      <div class="site-showcase-phone-top">
        <span class="site-showcase-handle" tabindex="0" role="button" aria-label="Move the phone" aria-describedby="{{ hint }}" data-drag-handle></span>
        <span class="site-showcase-level" aria-hidden="true"></span>
        <span class="site-showcase-led" aria-hidden="true"></span>
      </div>
      <div class="site-showcase-screen">
        <div class="site-showcase-viewport" tabindex="0" role="region" aria-label="{{ show.url }} on a phone, scrollable">
          <img src="{{ show.mobile.image }}" width="{{ show.mobile.width }}" height="{{ show.mobile.height }}" alt="{{ show.alt }} on a phone" loading="lazy" decoding="async" />
        </div>
      </div>
      <span class="site-showcase-grip" tabindex="0" role="button" aria-label="Resize the phone" aria-describedby="{{ hint }}" data-resize-handle></span>
    </div>
  </div>
  <p class="visually-hidden" id="{{ hint }}">Drag it, or use the arrow keys. Double-click the top bar, or press Home, to put it back.</p>
</section>
